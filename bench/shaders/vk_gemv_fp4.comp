/* vk_gemv_fp4.comp - eight output rows per workgroup, one 32-weight block per lane.
 *
 * Matches dsv4_matmul_fp4_avx2's structure, not its instruction order:
 *   - the dot product of one 32-wide block is formed in float with four
 *     independent accumulators (weights 0..7, 8..15, 16..23, 24..31),
 *   - the block scale (E8M0) and the cross-block fold are double.
 * A GPU cannot be bit-identical to the CPU tree; the bench gates this on the
 * same 1e-6 L2 bound the CUDA path used.
 *
 * Eight rows per 256-thread workgroup.  The earlier one-row/32-thread version
 * paid a workgroup launch, a barrier and a serial 32-double reduction per row;
 * at Flash's 2048-32768 output rows that overhead was larger than the weight
 * traffic.  Each logical 32-lane group now owns one row; the reduction is still
 * in shared memory, so no subgroup extension is required.
 */
#version 460

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer S { uint s[]; };
layout(std430, binding = 2) readonly buffer X { float x[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform PC {
    uint in_n;
    uint out_n;
    uint blk_r;
    uint blk_c;
    uint sc;
    uint w_off;   /* byte offset of W inside the imported buffer */
    uint s_off;   /* byte offset of S inside the imported buffer */
    uint w_row;   /* bytes per output row (in_n / 2) */
} pc;

/* E2M1: only sixteen codes, sign is bit 3.  Same table as dsv4_quant.h. */
const float FP4_LUT[16] = float[16](
     0.0,  0.5,  1.0,  1.5,  2.0,  3.0,  4.0,  6.0,
    -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0);

float e8m0(uint b)
{
    /* 0 means 2^-127, below f32's smallest normal; 0xFF is the format's NaN. */
    if (b == 0u)   return uintBitsToFloat(0x00400000u);
    if (b == 0xFFu) return uintBitsToFloat(0x7FC00000u);
    return uintBitsToFloat(b << 23);
}

uint sbyte(uint i)
{
    uint v = s[(pc.s_off + i) >> 2];
    return (v >> ((i & 3u) * 8u)) & 0xFFu;
}

/* The eight E2M1 magnitudes are {0, .5, 1, 1.5, 2, 3, 4, 6}.  A shared LUT
 * costs one shared load per weight; that load, not the FMA, was the kernel's
 * limit (40 GB/s against the FP8 kernel's 76).  Three selects and no memory. */
float fp4_val(uint code)
{
    const uint m = code & 7u;
    float v;
    if (m < 4u)      v = 0.5 * float(m);
    else if (m == 4u) v = 2.0;
    else if (m == 5u) v = 3.0;
    else if (m == 6u) v = 4.0;
    else              v = 6.0;
    return (code & 8u) != 0u ? -v : v;
}

/* One full 32-weight block.  Four words, one per accumulator, exactly the
 * grouping the AVX2 kernel uses before its horizontal sum. */
float block32(uint wbase, uint c0)
{
    uvec4 v = uvec4(w[wbase + 0u], w[wbase + 1u],
                    w[wbase + 2u], w[wbase + 3u]);
    float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;

    for (uint k = 0u; k < 8u; ++k) {
        uint s0 = (v.x >> (4u * k)) & 15u;
        uint s1 = (v.y >> (4u * k)) & 15u;
        uint s2 = (v.z >> (4u * k)) & 15u;
        uint s3 = (v.w >> (4u * k)) & 15u;
        a0 = fma(fp4_val(s0), x[c0 + k],       a0);
        a1 = fma(fp4_val(s1), x[c0 + 8u + k],  a1);
        a2 = fma(fp4_val(s2), x[c0 + 16u + k], a2);
        a3 = fma(fp4_val(s3), x[c0 + 24u + k], a3);
    }
    return (a0 + a1) + (a2 + a3);
}

/* Tail for a hand-built shape whose reduce dimension is not a multiple of 32.
 * Every released geometry takes block32; this exists so a wrong answer cannot
 * hide behind an assumed maximum. */
double tail_block(uint wbase_byte_off, uint c0, uint n)
{
    double acc = 0.0;
    for (uint k = 0u; k < n; ++k) {
        uint byte = w[(pc.w_off + wbase_byte_off + (k >> 1)) >> 2];
        uint nib  = (byte >> (((k >> 1) & 3u) * 8u + (k & 1u) * 4u)) & 15u;
        acc += double(FP4_LUT[nib]) * double(x[c0 + k]);
    }
    return acc;
}

shared double red[256];

void main()
{
    const uint tid  = gl_LocalInvocationIndex;
    const uint sg   = tid >> 5;          /* logical 32-lane group */
    const uint lane = tid & 31u;
    const uint nblk = (pc.in_n + pc.blk_c - 1u) / pc.blk_c;
    const uint lpr  = nblk >= 32u ? 32u : (nblk >= 16u ? 16u : 8u);
    const uint rpg  = 32u / lpr;
    const uint row  = lane / lpr;
    const uint lin  = lane % lpr;
    const uint o    = gl_WorkGroupID.x * (8u * rpg) + sg * rpg + row;

    double total = 0.0;
    if (o < pc.out_n) {
        const uint sbase = (o / pc.blk_r) * pc.sc;
        const uint wbase = (pc.w_off + o * pc.w_row) >> 2;

        for (uint b = lin; b < nblk; b += lpr) {
            const uint c0 = b * 32u;
            const uint n  = min(32u, pc.in_n - c0);
            double acc;
            if (n == 32u)
                acc = double(block32(wbase + b * 4u, c0));
            else
                acc = tail_block(o * pc.w_row + b * 16u, c0, n);
            total += acc * double(e8m0(sbyte(sbase + b)));
        }
    }

    red[tid] = total;
    barrier();
    if (lin == 0u && o < pc.out_n) {
        double sum = 0.0;
        for (uint i = 0u; i < lpr; ++i) sum += red[sg * 32u + row * lpr + i];
        y[o] = float(sum);
    }
}
