/* swiglu.comp - elementwise SwiGLU for the fused routed-expert pipeline.
 *
 * gate and up are [tokens][inter] row-major; the output has the same shape.
 * limit <= 0 disables clamping, matching dsv4_swiglu(). */
#version 460

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer G { float gv[]; };
layout(std430, binding = 1) readonly buffer U { float uv[]; };
layout(std430, binding = 2) writeonly buffer M { float mv[]; };

layout(push_constant) uniform PC {
    uint  n;       /* tokens */
    uint  k;       /* inter  */
    float limit;
} pc;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n * pc.k) return;

    float g = gv[i];
    float u = uv[i];
    if (pc.limit > 0.0) {
        u = clamp(u, -pc.limit, pc.limit);
        g = min(g, pc.limit);          /* deliberately no lower bound */
    }
    const float s = g / (1.0 + exp(-g));
    mv[i] = s * u;
}
