/* expert_fp4_fast.comp - routed-expert matvec, fast (not bit-exact) variant.
 *
 * Same mapping as expert_fp4.comp (four lanes per output row, one lane per
 * residue class, 64 rows per 256-thread workgroup), but the hot loop no longer
 * decodes each weight with a data-dependent branch:
 *
 *   fp4_lut[16]   one shared lookup per weight instead of fp4v()'s branch
 *                 chain. The 16 entries land on 16 distinct banks, so a
 *                 lookup never conflicts.
 *   e8m0_lut[256] one shared lookup per 32-weight block instead of the three
 *                 special-case branches in e8m0().
 *
 * The `precise` qualifiers are gone. That lets the compiler contract and
 * reassociate the reduction, which is what the low instruction count above
 * needs to actually turn into throughput. The result therefore is NOT
 * bit-identical to dsv4_mmq; the host gates this path with a tolerance. The
 * exact shader stays in expert_fp4.comp.
 *
 * Shared LUT initialisation runs at the top of main(), before the mode==1
 * early return, so every invocation reaches the barrier().
 */
#version 460

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer WT { uint  wv[]; };
layout(std430, binding = 1) readonly buffer SC { uint  sw[]; };
layout(std430, binding = 2) buffer BUF { float f[]; };

layout(push_constant) uniform PC {
    uint  in_n;        /* mode 0: reduce dimension; mode 1: element count   */
    uint  out_n;       /* mode 0: output rows                               */
    uint  sc;          /* scale bytes per row                               */
    uint  row_bytes;   /* packed weight bytes per row                       */
    uint  w_off;       /* byte offset of the weight matrix inside the slot  */
    uint  s_off;       /* byte offset of its scales inside the slot         */
    uint  x_off;       /* float offset of the input vector                  */
    uint  up_off;      /* mode 1: float offset of the up vector             */
    uint  y_off;       /* float offset of the output vector                 */
    uint  mode;
    float limit;       /* SWiGLU clamp                                      */
} pc;

#define ROWS_PER_WG 64u

shared float red[ROWS_PER_WG * 4u * 4u];
shared float fp4_lut[16];
shared float e8m0_lut[256];

/* E2M1 as the CPU's integer LUT, doubled: {0,1,2,3,4,6,8,12} with sign. Only
 * used to fill fp4_lut once per workgroup; the hot loop reads the table. */
float fp4v(uint code)
{
    uint m = code & 7u;
    int  v = int(m);
    if      (m == 4u) v = 4;
    else if (m == 5u) v = 6;
    else if (m == 6u) v = 8;
    else if (m == 7u) v = 12;
    return float((code & 8u) != 0u ? -v : v);
}

/* dsv4_e8m0_to_f32, branch for branch. Only used to fill e8m0_lut. */
float e8m0(uint b)
{
    if (b == 0x00u) return uintBitsToFloat(0x00400000u);   /* 2^-127 */
    if (b == 0xFFu) return uintBitsToFloat(0x7FC00000u);   /* NaN    */
    return uintBitsToFloat(b << 23u);
}

uvec4 load_w(uint word)
{
    return uvec4(wv[word], wv[word + 1u], wv[word + 2u], wv[word + 3u]);
}

/* One 32-weight block. Word k holds columns 8k..8k+7, one nibble each. */
float block_sum(uvec4 w, uint xb)
{
    float v[8];
    for (uint j = 0u; j < 8u; ++j) {
        const uint sh = j * 4u;
        float p0 = fp4_lut[(w.x >> sh) & 15u] * f[xb + j];
        float p1 = fp4_lut[(w.y >> sh) & 15u] * f[xb + 8u + j];
        float p2 = fp4_lut[(w.z >> sh) & 15u] * f[xb + 16u + j];
        float p3 = fp4_lut[(w.w >> sh) & 15u] * f[xb + 24u + j];
        v[j] = (p0 + p1) + (p2 + p3);
    }
    float lo = (v[0] + v[1]) + (v[2] + v[3]);
    float hi = (v[4] + v[5]) + (v[6] + v[7]);
    return lo + hi;
}

void main()
{
    const uint tid = gl_LocalInvocationIndex;

    if (tid < 16u)  fp4_lut[tid]  = fp4v(tid);
    if (tid < 256u) e8m0_lut[tid] = e8m0(tid);
    barrier();

    if (pc.mode == 1u) {
        const uint i = gl_GlobalInvocationID.x;
        if (i < pc.in_n) {
            float u = f[pc.up_off + i];
            u = min(u, pc.limit);
            u = max(u, -pc.limit);
            float g = f[pc.x_off + i];
            g = min(g, pc.limit);
            float s = g / (1.0 + exp(-g));
            f[pc.y_off + i] = s * u;
        }
        return;
    }

    const uint g   = tid >> 2u;                  /* row group inside the WG */
    const uint r   = tid & 3u;                   /* residue class           */
    const uint row = gl_WorkGroupID.x * ROWS_PER_WG + g;
    /* out_n is a multiple of ROWS_PER_WG for every released geometry, but clamp
     * rather than return: every thread must reach the barrier below. */
    const uint rr  = min(row, pc.out_n - 1u);

    const uint per = (pc.in_n >> 7u) >> 2u;      /* chunks / 4 */
    const uint wrow = pc.w_off + rr * pc.row_bytes;
    const uint srow = pc.s_off + rr * pc.sc;

    vec4 acc = vec4(0.0);

    for (uint i = 0u; i < per; ++i) {
        const uint c     = r + 4u * i;
        const uint boff  = wrow + c * 64u;
        const uint wb    = boff >> 2u;
        const uint xoff  = pc.x_off + c * 128u;

        vec4 b;
        b.x = block_sum(load_w(wb),      xoff);
        b.y = block_sum(load_w(wb + 4u), xoff +  32u);
        b.z = block_sum(load_w(wb + 8u), xoff +  64u);
        b.w = block_sum(load_w(wb + 12u), xoff + 96u);

        const uint sb = sw[(srow + c * 4u) >> 2u];
        vec4 s4 = vec4(e8m0_lut[sb         & 0xFFu],
                       e8m0_lut[(sb >>  8u) & 0xFFu],
                       e8m0_lut[(sb >> 16u) & 0xFFu],
                       e8m0_lut[sb >> 24u]);
        acc = vec4(fma(b.x, s4.x, acc.x), fma(b.y, s4.y, acc.y),
                   fma(b.z, s4.z, acc.z), fma(b.w, s4.w, acc.w));
    }

    red[(g * 4u + r) * 4u + 0u] = acc.x;
    red[(g * 4u + r) * 4u + 1u] = acc.y;
    red[(g * 4u + r) * 4u + 2u] = acc.z;
    red[(g * 4u + r) * 4u + 3u] = acc.w;
    barrier();

    if (r == 0u) {
        const uint base = (g * 4u) * 4u;
        vec4 a0 = vec4(red[base +  0u], red[base +  1u],
                       red[base +  2u], red[base +  3u]);
        vec4 a1 = vec4(red[base +  4u], red[base +  5u],
                       red[base +  6u], red[base +  7u]);
        vec4 a2 = vec4(red[base +  8u], red[base +  9u],
                       red[base + 10u], red[base + 11u]);
        vec4 a3 = vec4(red[base + 12u], red[base + 13u],
                       red[base + 14u], red[base + 15u]);
        vec4 t = (a0 + a1) + (a2 + a3);
        float S = (t.x + t.y) + (t.z + t.w);
        if (row < pc.out_n)
            f[pc.y_off + row] = 0.5 * S;
    }
}
